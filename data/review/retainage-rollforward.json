        "concepts": [
          { "id": "not-cumulative", "anyOf": ["not cumulative", "non-cumulative", "noncumulative", "activity", "movement", "in the quarter", "period only", "does not roll", "no prior balance", "prior quarter"] },
          { "id": "label", "anyOf": ["ending balance", "balance column", "labeled", "mislabel", "rollforward", "roll forward"] },
          { "id": "numbers", "anyOf": ["12,500", "12500", "108,750", "108750", "34,250", "34250", "96,250", "96250"] },
          { "id": "impossible", "anyOf": ["cannot fall", "can't fall", "should rise", "should increase", "went down", "decreas", "exceed", "more than released", "understat"] }
        ]
      },
      "causeSummary": "The ENDING balance row holds each quarter's activity rather than a cumulative balance: Q3 shows 12,500, which is just 70,500 withheld less 58,000 released, and the prior 96,250 was dropped instead of carried forward. A held balance cannot fall when the quarter withholds more than it releases, so the column contradicts its own label. Retainage carried into the AR split is therefore understated by 96,250 and the current portion is overstated by the same amount, which is why this fails review.",
      "tell": "The balance falls from 62,000 to 34,250 to 12,500 while every quarter withholds more than it releases. A rollforward that only goes down is not a balance."

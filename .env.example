# Accountrix environment variables
# Copy to `.env.local` and fill in. Every one is OPTIONAL — the app is fully
# usable (local-first) without any of them; these unlock the online features.

# --- AI Tutor (the streaming Claude "explain anything" assistant) ---
# Without this, the Ask-AI overlay falls back to lesson-title search.
# With it, /api/ai/tutor streams real explanations from claude-opus-4-8.
ANTHROPIC_API_KEY=

# --- Cross-device sync (Vercel KV) ---
# Without these, progress stays local (export/import still works).
# With them, /api/sync mirrors progress across devices by sync id.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Privacy denylist (optional) ---
# Regex of terms to strip before anything leaves the device.
PRIVACY_DENYLIST_REGEX=
